// grep_lines scans content line-by-line and prints lines that contain pattern.
//
// Parameters:
//   content      — full file (or stdin) text
//   pattern      — the search string
//   label        — filename prefix printed before each match when show_label is true
//   show_label   — prepend "label:" to each matching line
//   show_num     — prepend the 1-based line number to each matching line
//   ignore_case  — fold case before comparing
//   invert       — print lines that do NOT match (like grep -v)
//   quiet        — suppress all output; only the returned count matters
//   max_matches  — stop after this many matching lines (0 = unlimited)
//   color        — highlight the matched portion with ANSI bold-red
//   before_ctx   — number of lines to print before each match
//   after_ctx    — number of lines to print after each match
//
// Returns the number of matching lines.
//
// Implementation: single streaming pass over content.  Lines are processed one
// at a time by scanning for '\n' boundaries; only before_ctx lines are held in
// memory at once (as a small sliding-window buffer).  This avoids building a
// full string[] of all lines, keeping peak RSS proportional to the largest
// before_ctx window rather than the size of the file.
fn grep_lines(
    content: string,
    pattern: string,
    label: string,
    show_label: bool,
    show_num: bool,
    ignore_case: bool,
    invert: bool,
    quiet: bool,
    max_matches: int,
    color: bool,
    before_ctx: int,
    after_ctx: int
): int {
    let search_pattern: string = "";
    if (ignore_case) {
        search_pattern = string_to_lower(pattern);
    } else {
        search_pattern = pattern;
    }

    let matched: int = 0;
    let limit_hit: bool = false;
    let clen: int = len(content);
    let line_start: int = 0;
    let line_num: int = 1;
    let use_context: bool = before_ctx > 0 || after_ctx > 0;

    // Sliding window of the most recent before_ctx non-match lines.
    // Flushed (and printed) when a match is found.
    let ctx_lines: string[] = [];
    let ctx_nums: int[] = [];

    // How many more after-context lines to print after the last match.
    let remaining_after: int = 0;

    // Line number of the last line printed (for "--" separator detection).
    let last_printed_num: int = -1;

    let ci: int = 0;
    while (ci <= clen) {
        // Determine whether to process a line ending here.
        let process: bool = false;
        let end_pos: int = ci;
        if (ci < clen && char_at(content, ci) == '\n') {
            process = true;
        } else if (ci == clen && line_start < clen) {
            // Last line with no trailing newline.
            process = true;
        }

        if (process) {
            let line: string = string_slice(content, line_start, end_pos);
            let is_match: bool = false;
            let sl_lower: string = "";
            if (ignore_case) {
                sl_lower = string_to_lower(line);
                is_match = string_contains(sl_lower, search_pattern) != invert;
            } else {
                is_match = string_contains(line, search_pattern) != invert;
            }

            if (is_match && !limit_hit) {
                matched = matched + 1;
                if (!quiet) {
                    // Flush the before-context buffer, with separator if needed.
                    if (len(ctx_lines) > 0) {
                        if (last_printed_num >= 0 && ctx_nums[0] > last_printed_num + 1) {
                            print("--");
                        }
                        let bi: int = 0;
                        while (bi < len(ctx_lines)) {
                            if (show_label) { write(label + "-"); }
                            if (show_num) { write(int_to_string(ctx_nums[bi]) + "-"); }
                            print(ctx_lines[bi]);
                            last_printed_num = ctx_nums[bi];
                            bi = bi + 1;
                        }
                    } else if (use_context && remaining_after == 0 && last_printed_num >= 0 && line_num > last_printed_num + 1) {
                        // Gap between the end of a previous context group and this match.
                        print("--");
                    }

                    // Print the match line itself.
                    if (show_label) { write(label + ":"); }
                    if (show_num) { write(int_to_string(line_num) + ":"); }
                    if (color && !invert) {
                        let pos: int = string_index_of(line, search_pattern);
                        if (ignore_case) {
                            pos = string_index_of(sl_lower, search_pattern);
                        }
                        if (pos >= 0) {
                            let esc: string = char_to_string(27);
                            write(string_slice(line, 0, pos) + esc + "[1;31m");
                            write(string_slice(line, pos, pos + len(search_pattern)) + esc + "[0m");
                            print(string_slice(line, pos + len(search_pattern), len(line)));
                        } else {
                            print(line);
                        }
                    } else {
                        print(line);
                    }
                    last_printed_num = line_num;
                }
                // Reset context state.
                let empty_lines: string[] = [];
                let empty_nums: int[] = [];
                ctx_lines = empty_lines;
                ctx_nums = empty_nums;
                remaining_after = after_ctx;
                if (max_matches > 0 && matched >= max_matches) {
                    limit_hit = true;
                }
            } else if (remaining_after > 0) {
                // After-context line: print it, then decrement the counter.
                if (!quiet) {
                    if (show_label) { write(label + "-"); }
                    if (show_num) { write(int_to_string(line_num) + "-"); }
                    print(line);
                    last_printed_num = line_num;
                }
                remaining_after = remaining_after - 1;
                // After-context lines don't feed the before-context buffer.
                let empty_lines2: string[] = [];
                let empty_nums2: int[] = [];
                ctx_lines = empty_lines2;
                ctx_nums = empty_nums2;
                if (remaining_after == 0 && limit_hit) {
                    // max_matches hit and after-context exhausted — stop.
                    break;
                }
            } else if (limit_hit) {
                break;
            } else {
                // Non-match outside any context window.
                // Accumulate into the before-context sliding window.
                if (before_ctx > 0) {
                    push(ctx_lines, line);
                    push(ctx_nums, line_num);
                    // Keep only the most recent before_ctx entries.
                    if (len(ctx_lines) > before_ctx) {
                        let new_lines: string[] = [];
                        let new_nums: int[] = [];
                        let ti: int = len(ctx_lines) - before_ctx;
                        while (ti < len(ctx_lines)) {
                            push(new_lines, ctx_lines[ti]);
                            push(new_nums, ctx_nums[ti]);
                            ti = ti + 1;
                        }
                        ctx_lines = new_lines;
                        ctx_nums = new_nums;
                    }
                }
            }

            line_start = end_pos + 1;
            line_num = line_num + 1;
            if (ci == clen) { break; }
        }

        ci = ci + 1;
    }

    return matched;
}
