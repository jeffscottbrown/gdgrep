include @string

// grep_lines scans content line-by-line and prints lines that contain pattern.
//
// Parameters:
//   content      — full file (or stdin) text
//   pattern      — the search string (already lowercased when ignore_case is true)
//   label        — filename prefix printed before each match when show_label is true
//   show_label   — prepend "label:" to each matching line
//   show_num     — prepend the 1-based line number to each matching line
//   ignore_case  — fold case before comparing
//   invert       — print lines that do NOT match (like grep -v)
//   quiet        — suppress all output; only the returned count matters
//   max_matches  — stop after this many matching lines (0 = unlimited)
//   color        — highlight the matched portion with ANSI bold-red
//
// Returns the number of matching lines.
fn grep_lines(
    content: string,
    pattern: string,
    label: string,
    show_label: bool,
    show_num: bool,
    ignore_case: bool,
    invert: bool,
    quiet: bool,
    max_matches: int,
    color: bool
): int {
    let matched: int = 0;
    let start: int = 0;
    let total: int = len(content);
    let linenum: int = 1;

    let search_pattern: string = pattern;
    if (ignore_case) {
        search_pattern = lower_str(pattern);
    }

    while (start <= total) {
        // Locate the end of the current line (newline = char code 10).
        let end: int = start;
        while (end < total && char_at(content, end) != 10) {
            end = end + 1;
        }

        let line: string = string_slice(content, start, end);

        let search_line: string = line;
        if (ignore_case) {
            search_line = lower_str(line);
        }

        let raw_match: bool = contains(search_line, search_pattern);
        let line_matches: bool = raw_match != invert;

        if (line_matches) {
            if (!quiet) {
                if (show_label) {
                    write(label + ":");
                }
                if (show_num) {
                    write(int_to_string(linenum) + ":");
                }
                if (color && !invert) {
                    let pos: int = index_of(search_line, search_pattern);
                    if (pos >= 0) {
                        let esc: string = char_to_string(27);
                        let before_text: string = string_slice(line, 0, pos);
                        let match_text: string = string_slice(line, pos, pos + len(search_pattern));
                        let after_text: string = string_slice(line, pos + len(search_pattern), len(line));
                        print(before_text + esc + "[1;31m" + match_text + esc + "[0m" + after_text);
                    } else {
                        print(line);
                    }
                } else {
                    print(line);
                }
            }
            matched = matched + 1;
            if (max_matches > 0 && matched >= max_matches) {
                break;
            }
        }

        start = end + 1;
        linenum = linenum + 1;
    }

    return matched;
}
